# Copy to .env and adjust. Everything here can also be changed later in Server dashboard → Settings.

# Where your media lives on the host. Inside the container it appears as /media.
MEDIA_DIR=/srv/media

# Where Streamarr keeps its database, artwork cache and preview thumbnails.
CONFIG_DIR=./data

# User/group that can read your media (run `id` on the host).
PUID=1000
PGID=1000

PORT=8420
TZ=Europe/Budapest

# Free key from https://www.themoviedb.org/settings/api – adds posters, backdrops, cast, descriptions.
TMDB_API_KEY=

# none | vaapi | nvenc   (use with docker-compose.vaapi.yml / docker-compose.nvidia.yml)
HWACCEL=none
# For VAAPI: `getent group render | cut -d: -f3` and `getent group video | cut -d: -f3`
RENDER_GID=105
VIDEO_GID=44

# CPU transcoding: faster presets keep up on weaker CPUs.
TRANSCODE_PRESET=veryfast
# Highest resolution offered for CPU transcodes (GPU setups override this to 2160).
MAX_SOFTWARE_HEIGHT=1080

# RAM for transcode segments (tmpfs).
TRANSCODE_TMPFS_SIZE=4g
